# Copy to .env and fill in your values

# Required: Anthropic API key for workout/route AI generation
ANTHROPIC_API_KEY=sk-ant-...

# Required for Notion WOD integration
# Create an integration at https://www.notion.so/my-integrations
# and share your WOD Table database with it
NOTION_API_KEY=secret_...

# Optional: where to store Garmin OAuth tokens (default: ~/.garth_coach)
GARTH_HOME=~/.garth_coach
